{
  "name": "hostel-management-system",
  "version": "1.0.0",
  "description": "AI-Powered Hostel Community & Event Management System",
  "main": "index.js",
  "scripts": {
    "install-all": "npm run install-backend && npm run install-web && npm run install-mobile",
    "install-backend": "cd backend && npm install",
    "install-web": "cd web-dashboard && npm install",
    "install-mobile": "cd mobile-app && npm install",
    "dev": "concurrently \"npm run dev-backend\" \"npm run dev-web\"",
    "dev-backend": "cd backend && npm run dev",
    "dev-web": "cd web-dashboard && npm start",
    "dev-mobile": "cd mobile-app && npx react-native run-android",
    "build": "npm run build-backend && npm run build-web",
    "build-backend": "cd backend && npm run build",
    "build-web": "cd web-dashboard && npm run build",
    "test": "npm run test-backend && npm run test-web",
    "test-backend": "cd backend && npm test",
    "test-web": "cd web-dashboard && npm test",
    "lint": "npm run lint-backend && npm run lint-web",
    "lint-backend": "cd backend && npm run lint",
    "lint-web": "cd web-dashboard && npm run lint"
  },
  "keywords": [
    "hostel-management",
    "attendance-system",
    "facial-recognition",
    "leave-management",
    "community-platform",
    "event-management",
    "ai-powered",
    "react-native",
    "nodejs"
  ],
  "author": "Hostel Management Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  },

  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
